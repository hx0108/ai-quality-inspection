# 环境配置文件（复制为 .env 后填入真实密钥）
# 请勿提交到版本库！

# 应用配置
DEBUG=false

# 数据库配置（SQLite）
DATABASE_URL=sqlite:///./data/inspection.db

# JWT 密钥（生产环境必须修改！生成命令：python -c "import secrets; print(secrets.token_urlsafe(48))"）
SECRET_KEY=your-secret-key-here

# CORS 允许的前端域名（多个用英文逗号分隔）
# 示例：http://localhost:5173,http://192.168.1.100:5173,https://your-domain.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 通义千问 API（评分用）
DASHSCOPE_API_KEY=your-dashscope-api-key

# DeepSeek API（报告用）
DEEPSEEK_API_KEY=your-deepseek-api-key
