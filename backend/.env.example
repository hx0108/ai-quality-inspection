# 环境配置文件（复制为 .env 后填入真实密钥）
# 请勿提交到版本库！

# 应用配置
DEBUG=false

# 数据库配置（SQLite）
DATABASE_URL=sqlite:///./data/inspection.db

# JWT 密钥（生产环境必须修改！生成命令：python -c "import secrets; print(secrets.token_urlsafe(48))"）
SECRET_KEY=your-secret-key-here

# CORS 允许的前端域名（多个用英文逗号分隔）
# 示例：http://localhost:5173,http://192.168.1.100:5173,https://your-domain.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 通义千问 API（评分用）
DASHSCOPE_API_KEY=your-dashscope-api-key

# DeepSeek API（报告用）
DEEPSEEK_API_KEY=your-deepseek-api-key

# 企业微信群机器人 Webhook（群聊右上角"添加机器人"获取，留空则不推送）
WECOM_WEBHOOK_URL=

# Jev 判断模型（TypeSafe System One）——AI评分/整改复核置信度校准
# Key 申请：console.typesafe.ai/keys
JEV_API_KEY=your-typesafe-api-key
# 总开关（false=完全跳过 Jev，行为与现在完全一致）
JEV_ENABLED=false
# shadow=只记录交叉验证结果不改路由；active=Jev 概率参与判定（建议先 shadow 观察）
JEV_MODE=shadow
# JEV_BASE_URL=https://api.typesafe.ai
# JEV_MODEL=jev-latest
# active 模式下，Jev 判"结论正确"概率低于此值 → 强制人工复核
# JEV_REVIEW_THRESHOLD=0.7
